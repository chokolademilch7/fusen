{
  // Declaration emit for the published `fusen` package, run by
  // scripts/build-npm.ts. Not a typecheck: `bun run typecheck` owns that. It
  // spans all five packages because each subpath's types reach into core, and
  // ui/lite need Solid's JSX settings, the same as their own tsconfigs.
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": "dist/types",
    "types": ["bun"]
  },
  "include": ["../core/src", "../ui/src", "../lite/src", "../server/src", "../mcp/src"],
  "exclude": ["../**/*.test.ts", "../**/*.test.tsx"]
}
