{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "examples/plain/fusen-lite.js",
    "packages/core/test/pre-extraction-anchor.ts"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-underscore-dangle": ["warn", { "allow": ["__fusen", "__resetFeedbackStoreForTests"] }],
    "no-await-in-loop": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/require-post-message-target-origin": "off",
    "oxc/no-map-spread": "off"
  },
  "overrides": [
    {
      "files": ["packages/ui/src/**", "packages/lite/src/**"],
      "rules": {
        "no-unused-expressions": "off",
        "no-unassigned-vars": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/testkit.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ]
}
